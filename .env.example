# 本地（非 Docker）验证时使用的环境变量；docker-compose 内部已内置等价配置。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=platform
DB_USER=api_user
DB_PASSWORD=api_secret_pw
API_KEYS_JSON='{"key-p1-demo-001":"P1","key-p2-demo-002":"P2"}'
# 管理员密钥：仅可调用 /admin/* 撤回接口；与课题密钥分开保管
ADMIN_API_KEY=admin-key-demo-900
API_POOL_MAX=2
API_POOL_MIN=1
API_MAX_ROWS=200
API_STATEMENT_TIMEOUT_MS=10000
# 撤回收尾安全上限（秒）与演示钩子开关
API_DRAIN_SAFETY_TIMEOUT=45
API_DEMO_HOOKS_ENABLED=1
API_DEMO_DELAY_MAX_MS=8000
